  {
   "name": "publishing rules",
   "steps": [
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "publish",
     "service": "chat",
     "patch": {
      "max_attempts": 3
     },
     "error": {
      "code": "version_exists",
      "status": 409
     }
    },
    {
     "op": "publish",
     "service": "chat",
     "patch": {
      "version": 2
     }
    },
    {
     "op": "publish",
     "service": "chat",
     "patch": {
      "version": 2
     }
    },
    {
     "op": "publish",
     "service": "chat",
     "patch": {
      "version": 3
     }
    },
    {
     "op": "publish",
     "service": "chat",
     "patch": {
      "version": 3,
