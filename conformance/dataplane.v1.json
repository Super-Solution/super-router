 "scenarios": [
  {
   "name": "settle a successful request",
   "steps": [
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "as": "r1",
     "expect": {
      "execution_status": "succeeded",
      "billing_status": "settled",
      "service_version": 1,
      "model": "mock-model",
      "tier": "chat/low",
      "output": {
       "role": "assistant",
       "content": "Hello from SuperRouter."
      },
      "usage": {
       "status": "confirmed",
       "meters": {
        "input": 10,
        "cached": 0,
        "cache_write": 0,
        "output": 5
       }
      },
      "billing": {
       "charges": [
        {
         "kind": "customer_sale",
         "asset": "credit:demo",
         "atoms": "35",
         "scale": 9
        }
       ]
      }
     }
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "asset": "credit:demo",
       "balance": "99965",
       "held": "0",
       "available": "99965"
      }
     ]
    },
    {
     "op": "get",
     "request": "r1",
     "expect": {
      "execution": "succeeded",
      "billing": "settled",
      "output_started": true,
      "provider_spent": "15"
     }
    }
   ]
  },
  {
   "name": "platform leg is charged and shown to billing readers",
   "steps": [
    {
     "op": "publish",
     "service": "chat_platform"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "grant",
     "kind": "platform_sale",
     "asset": "credit:platform",
     "amount": "50000",
     "source": "p1"
    },
    {
     "op": "infer",
     "as": "r1",
     "expect": {
      "billing": {
       "charges": [
        {
         "kind": "customer_sale",
         "atoms": "35"
        },
        {
         "kind": "platform_sale",
         "asset": "credit:platform",
         "atoms": "15"
        }
       ]
      }
     }
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "asset": "credit:demo",
       "balance": "99965",
       "held": "0",
       "available": "99965"
      },
      {
       "kind": "platform_sale",
       "asset": "credit:platform",
       "balance": "49985",
       "held": "0",
       "available": "49985"
      }
     ]
    }
   ]
  },
  {
   "name": "replay with the same key returns the first request and does not call the provider again",
   "steps": [
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "key": "k1",
     "as": "r1"
    },
    {
     "op": "infer",
     "key": "k1",
     "expect": {
      "replayed": true,
      "id": "$r1",
      "execution_status": "succeeded",
      "billing_status": "settled"
     }
    },
    {
     "op": "provider_calls",
     "provider": "ok",
     "expect": 1
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "asset": "credit:demo",
       "balance": "99965",
       "held": "0",
       "available": "99965"
      }
     ]
    }
   ]
  },
  {
   "name": "same key with a different body conflicts",
   "steps": [
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "key": "k1"
    },
    {
     "op": "infer",
     "key": "k1",
     "input": {
      "input": {
       "messages": [
        {
         "role": "user",
         "content": "Different"
        }
       ]
      }
     },
     "error": {
      "code": "idempotency_conflict",
      "status": 409
     }
    }
   ]
  },
  {
   "name": "insufficient balance is refused before any provider call",
   "steps": [
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100",
     "source": "g1"
    },
    {
     "op": "infer",
     "error": {
      "code": "insufficient_balance",
      "status": 402
     }
    },
    {
     "op": "provider_calls",
     "provider": "ok",
     "expect": 0
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "asset": "credit:demo",
       "balance": "100",
       "held": "0",
       "available": "100"
      }
     ]
    }
   ]
  },
  {
   "name": "a customer with no account is refused",
   "steps": [
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "infer",
     "error": {
      "code": "insufficient_balance",
      "status": 402
     }
    }
   ]
  },
  {
   "name": "a definitive retryable failure falls back to the next offering",
   "steps": [
    {
     "op": "publish",
     "service": "chat_two"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "expect": {
      "execution_status": "succeeded",
      "billing_status": "settled"
     }
    },
    {
     "op": "provider_calls",
     "provider": "bad",
     "expect": 1
    },
    {
     "op": "provider_calls",
     "provider": "ok",
     "expect": 1
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "asset": "credit:demo",
       "balance": "99965",
       "held": "0",
       "available": "99965"
      }
     ]
    }
   ]
  },
  {
   "name": "every offering failing releases the reservation",
   "steps": [
    {
     "op": "publish",
     "service": "chat_bad"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "as": "r1",
     "expect": {
      "execution_status": "failed",
      "billing_status": "released",
      "usage": {
       "status": "not_billable"
      },
      "billing": {
       "charges": []
      }
     }
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "asset": "credit:demo",
       "balance": "100000",
       "held": "0",
       "available": "100000"
      }
     ]
    }
   ]
  },
  {
   "name": "an unknown provider outcome keeps the reservation pending",
   "steps": [
    {
     "op": "publish",
     "service": "chat_lost"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "as": "r1",
     "expect": {
      "execution_status": "unknown",
      "billing_status": "pending",
      "usage": {
       "status": "pending"
      }
     }
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "balance": "100000",
       "held": ">0"
      }
     ]
    },
    {
     "op": "get",
     "request": "r1",
     "expect": {
      "execution": "unknown",
      "billing": "pending",
      "provider_spent": "0"
     }
    }
   ]
  },
  {
   "name": "output delivered before a failure is partial and pending",
   "steps": [
    {
     "op": "publish",
     "service": "chat_half"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "as": "r1",
     "expect": {
      "execution_status": "partial",
      "billing_status": "pending",
      "output": {
       "content": "Hello from SuperRouter."
      }
     }
    },
    {
     "op": "balance",
     "expect": [
      {
       "kind": "customer_sale",
       "balance": "100000",
       "held": ">0"
      }
     ]
    },
    {
     "op": "get",
     "request": "r1",
     "expect": {
      "execution": "partial",
      "billing": "pending",
      "output_started": true
     }
    }
   ]
  },
  {
   "name": "scope and customer binding",
   "steps": [
    {
     "op": "publish",
     "service": "chat"
    },
    {
     "op": "grant",
     "kind": "customer_sale",
     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "infer",
     "principal": "no_invoke",
     "error": {
      "code": "scope_denied",
      "status": 403
     }
    },
    {
     "op": "infer",
     "principal": "scoped",
     "error": {
      "code": "scope_denied",
      "status": 403
     }
    },
    {
     "op": "infer",
     "input": {
      "customer_id": "c2"
     },
     "error": {
      "code": "scope_denied",
      "status": 403
     }
    },
    {
     "op": "infer",
     "principal": "other",
     "input": {
      "customer_id": "c2"
     },
     "error": {
      "code": "insufficient_balance",
      "status": 402
     }
    },
    {
     "op": "infer",
     "as": "r1"
    },
    {
     "op": "get",
     "request": "r1",
     "principal": "other",
     "error": {
      "code": "resource_not_found",
      "status": 404
     }
    }
   ]
  },
  {
   "name": "unknown service",
   "steps": [
