     "asset": "credit:demo",
     "amount": "100000",
     "source": "g1"
    },
    {
     "op": "disable",
     "offering": "a"
    },
    {
     "op": "infer",
     "expect": {
      "execution_status": "failed",
      "billing_status": "released"
     }
    },
    {
     "op": "provider_calls",
     "provider": "ok",
     "expect": 0
