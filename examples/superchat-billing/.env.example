# All optional. The example reads these from the environment; it does not load this file.
# PostgreSQL started by `npm run db:up`.
DATABASE_URL=postgresql://superrouter:local-development-only@127.0.0.1:25432/superrouter
SUPERCHAT_ROUTER_PORT=4400
SUPERCHAT_CHAT_PORT=4410
SUPERCHAT_CONSOLE_PORT=4420
# Where the local workspace identity is kept (defaults to examples/superchat-billing/.local/state.json).
# SUPERCHAT_STATE_FILE=
