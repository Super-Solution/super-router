# Optional. Defaults target the repository's local PostgreSQL container.
# DATABASE_URL=postgresql://superrouter:local-development-only@127.0.0.1:25432/superrouter
PAID_CHAT_PORT=4317
PAID_CHECKOUT_PORT=4318
# Optional server-only secret. Keep stable to preserve signed sandbox checkout links.
# PAID_SANDBOX_SECRET=
# Optional executable for browser smoke; otherwise run npx playwright install chromium.
# PLAYWRIGHT_EXECUTABLE_PATH=

# Same app: local protocol fixtures are the default, with no external requests.
PAID_PAYMENT_MODE=fixture
# Merchant composition (explicitly opt in; never use fixture signing material):
# PAID_PAYMENT_MODE=merchant
# PAID_PUBLIC_ORIGIN=https://your-app.example
# PAID_WORKSPACE=your-dedicated-test-workspace
# PAID_SERVER_SECRET=  # private random >=32-character server-only secret
# PAID_HOST_KEY=       # private sr_ + 64 hex owner bootstrap key; distinct per environment
# All enabled merchant gateways MUST use the same test/live mode.
# PAID_STRIPE_MODE=test
# PAID_STRIPE_SECRET_KEY=
# PAID_STRIPE_WEBHOOK_SECRET=
# PAID_STRIPE_ACCOUNT_ID=
# PAID_OEN_MODE=test
# PAID_OEN_TOKEN=
# PAID_OEN_WEBHOOK_SECRET=
# PAID_OEN_MERCHANT_ID=
# PAID_EPAY_MODE=test
# PAID_EPAY_ENDPOINT=https://your-test-payment-site.example/
# PAID_EPAY_PID=
# PAID_EPAY_KEY=
