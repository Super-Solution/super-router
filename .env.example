# Local-only development database; never use these credentials in production.
DATABASE_URL=postgresql://superrouter:local-development-only@127.0.0.1:25432/superrouter
PORT=3410
# Server API key: sr_ followed by 64 random hex characters. Digest key: >=32 characters.
# Owner bootstrap is create-once; same key on restart, no automatic overwrite. Demo generates ephemeral keys in memory.
SUPERROUTER_API_KEY=
SUPERROUTER_DIGEST_KEY=
# Optional live smoke only; never required by demo/test.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional test-only payment ingress on local server, integration id local-sandbox.
SUPERROUTER_SANDBOX_PAYMENT_SECRET=
