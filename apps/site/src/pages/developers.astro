---
import Base from '../layouts/Base.astro';

const upstreams = ['OpenAI', 'Anthropic', 'vLLM', 'Ollama', 'OpenRouter', 'DeepSeek', 'any OpenAI-compatible server'];

const requests = [
  { time: '15:03:12', service: 'chat/low', provider: 'anthropic', tokens: '1,204 / 388', cost: '0.0021', charge: '0.0035', status: 'Settled', tone: 'ok' },
  { time: '15:02:47', service: 'coding/high', provider: 'openai → anthropic', tokens: '3,880 / 1,120', cost: '0.0190', charge: '0.0240', status: 'Settled · fallback', tone: 'ok' },
  { time: '15:01:30', service: 'chat/low', provider: 'openai', tokens: '—', cost: '0.0000', charge: '0.0000', status: 'Upstream failed · released', tone: 'idle' },
  { time: '15:00:58', service: 'chat/low', provider: 'vllm-local', tokens: '640 / ?', cost: 'pending', charge: 'held', status: 'Reconciliation', tone: 'warn' },
];

const features = [
  {
    title: 'Routing',
    items: [
      'Versioned Services: a specific model, a pool or a tier',
      'Region, capability and price limits apply before scoring',
      'Shared health and circuit breakers',
      'Fails over only when the upstream definitely didn’t run',
    ],
  },
  {
    title: 'Billing',
    items: [
      'Reserve before the call, settle on actual usage',
      'BigInt atoms and idempotent replays',
      'Credits with expiry and Service scope, subscriptions, prorated upgrades',
      'Stripe, Epay V1 and OEN hosted checkout (sandbox-verified)',
    ],
  },
  {
    title: 'Operations',
    items: [
      'Gapless invoices, voids and credit notes; tax table or your tax webhook',
      'Workspaces, projects and roles; OIDC, passkeys, TOTP',
      'Per-key spend, rate, concurrency and IP limits',
      'Webhooks with SSRF protection, metrics, audit log',
    ],
  },
];

const failures = [
  { when: 'Rejected, no candidate, or insufficient balance', charge: 'Nothing', cost: 'None; nothing ran' },
  { when: 'First attempt failed, fallback succeeded', charge: 'Once, for the result', cost: 'Every attempt recorded' },
  { when: 'Every attempt failed', charge: 'Nothing; hold released', cost: 'Known and pending cost kept apart' },
  { when: 'Stream cut after partial output', charge: 'Confirmed usage only', cost: 'Unknown usage goes to reconciliation' },
  { when: 'Outcome unknown', charge: 'Hold kept, not retried', cost: 'Reconciliation queue' },
];

const compare = [
  { row: 'Routing, billing, invoices', self: 'Included', cloud: 'Included' },
  { row: 'Your own upstream API keys', self: 'Required', cloud: 'Not needed' },
  { row: 'Payments and tax', self: 'Your integration', cloud: 'Handled by Cloud' },
  { row: 'Shared user wallet (Sign in with SuperRouter)', self: '—', cloud: 'Included' },
  { row: 'Per-key and per-app statistics', self: '—', cloud: 'Included' },
  { row: 'Markup on token usage', self: 'Your own prices', cloud: '0, 10, 20, 30 or 50%' },
  { row: 'Price', self: '—', cloud: 'Not announced' },
];
---

<Base
  title="SuperRouter for developers — an AI gateway with billing built in"
  description="OpenAI-compatible AI gateway you can self-host. Reserve before the call, settle on actual usage, and keep provider cost and customer charges in separate ledgers."
  section="developers"
>
  <section class="hero wrap">
    <div class="hero__copy">
      <h1 class="h1">The AI gateway with billing built in.</h1>
      <p class="lede">
        An OpenAI-compatible API you can host yourself. Every request is reserved up front, settled
        on actual usage, and recorded with what it cost upstream and what your customer paid.
      </p>
      <div class="hero__actions">
        <a class="btn btn--accent" href="#quickstart">Run it locally</a>
        <a class="btn btn--ghost" href="#deploy">Compare Cloud and self-host</a>
      </div>
    </div>

    <div class="tabs panel" data-tabs>
      <div class="tabs__bar" role="tablist" aria-label="Example code">
        <button type="button" role="tab" id="t-openai" aria-controls="p-openai" aria-selected="true">OpenAI SDK</button>
        <button type="button" role="tab" id="t-curl" aria-controls="p-curl" aria-selected="false" tabindex="-1">cURL</button>
        <button type="button" role="tab" id="t-sdk" aria-controls="p-sdk" aria-selected="false" tabindex="-1">@superrouter/sdk</button>
      </div>
      <pre class="code" id="p-openai" role="tabpanel" aria-labelledby="t-openai"><span class="k">import</span> OpenAI <span class="k">from</span> <span class="s">"openai"</span>;

<span class="k">const</span> client = <span class="k">new</span> OpenAI(&#123;
  apiKey: process.env.SUPERROUTER_KEY,
  <span class="a">baseURL: "https://&lt;your-superrouter&gt;/v1",</span>
&#125;);

<span class="k">const</span> stream = <span class="k">await</span> client.chat.completions.create(&#123;
  model: <span class="s">"chat/low"</span>, <span class="c">// a Service you published</span>
  messages,
  stream: <span class="k">true</span>,
&#125;);</pre>
      <pre class="code" id="p-curl" role="tabpanel" aria-labelledby="t-curl" hidden>curl https://&lt;your-superrouter&gt;/v1/chat/completions \
  -H <span class="s">"Authorization: Bearer $SUPERROUTER_KEY"</span> \
  -H <span class="s">"Idempotency-Key: order-42"</span> \
  -H <span class="s">"Content-Type: application/json"</span> \
  -d <span class="s">'&#123;"model":"chat/low","messages":[&#123;"role":"user","content":"Hi"&#125;]&#125;'</span></pre>
      <pre class="code" id="p-sdk" role="tabpanel" aria-labelledby="t-sdk" hidden><span class="k">import</span> &#123; SuperRouterClient &#125; <span class="k">from</span> <span class="s">"@superrouter/sdk"</span>;

<span class="k">const</span> client = <span class="k">new</span> SuperRouterClient(&#123;
  baseUrl: <span class="s">"https://&lt;your-superrouter&gt;"</span>,
  apiKey: process.env.SUPERROUTER_KEY,
&#125;);

<span class="c">// Streaming, replay status, cancellation and usage queries.</span>
<span class="c">// Not yet published to npm.</span></pre>
    </div>
  </section>

  <div class="wrap upstreams">
    <span class="muted">Routes to</span>
    {upstreams.map((u) => <span>{u}</span>)}
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="h2">Know what every request cost, and what you charged for it.</h2>
        <p class="copy">
          Provider cost and customer charge sit side by side for each request. Anything that can’t
          be confirmed is held and queued for reconciliation, never treated as free.
        </p>
      </div>
      <div class="table-box">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Time</th>
              <th scope="col">Service</th>
              <th scope="col">Provider</th>
              <th scope="col" class="r">Tokens in / out</th>
              <th scope="col" class="r">Provider cost</th>
              <th scope="col" class="r">Charged</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody class="mono">
            {
              requests.map((r) => (
                <tr>
                  <td class="muted">{r.time}</td>
                  <td>{r.service}</td>
                  <td>{r.provider}</td>
                  <td class="r">{r.tokens}</td>
                  <td class="r">{r.cost}</td>
                  <td class="r">{r.charge}</td>
                  <td class="status">
                    <span class={`dot dot--${r.tone}`} />
                    {r.status}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note muted">Example data, in credits. 1 credit = 1,000,000,000 atoms.</p>
    </div>
  </section>

  <section id="features" class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="h2">Routing, metering and invoicing in one service.</h2>
      </div>
      <div class="cells">
        {
          features.map((f) => (
            <div>
              <h3 class="h3">{f.title}</h3>
              <ul class="list">
                {f.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="h2">When things fail, the ledger stays honest.</h2>
        <p class="copy">
          Failover happens only when the upstream definitely didn’t run. The ledger is append-only:
          refunds and corrections never rewrite the original entry.
        </p>
      </div>
      <div class="table-box">
        <table class="table">
          <thead>
            <tr><th scope="col">Situation</th><th scope="col">Customer is charged</th><th scope="col">Provider cost</th></tr>
          </thead>
          <tbody>
            {
              failures.map((f) => (
                <tr>
                  <td>{f.when}</td>
                  <td>{f.charge}</td>
                  <td class="muted">{f.cost}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="deploy" class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="h2">Host it yourself, or use Cloud.</h2>
        <p class="copy">
          The same core runs both. Cloud adds the shared user wallet and per-key statistics; it
          isn’t open yet.
        </p>
      </div>
      <div class="table-box">
        <table class="table compare">
          <thead>
            <tr><th scope="col"></th><th scope="col">Self-host</th><th scope="col">Cloud <span class="soon">Not open yet</span></th></tr>
          </thead>
          <tbody>
            {
              compare.map((c) => (
                <tr>
                  <th scope="row">{c.row}</th>
                  <td>{c.self}</td>
                  <td>{c.cloud}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="quickstart" class="section">
    <div class="wrap quick">
      <div>
        <h2 class="h2">Run it locally in four commands.</h2>
        <p class="copy">
          Needs Node.js 24 and Docker. The demo uses a mock model, so it costs nothing; the
          database, HTTP, streaming and ledger all run for real.
        </p>
        <p class="copy muted small">
          Development release · 155 tests passing · license not decided yet.
        </p>
      </div>
      <pre class="code"><span class="c">$</span> npm ci
<span class="c">$</span> npm run build
<span class="c">$</span> npm run db:up
<span class="c">$</span> npm run demo</pre>
    </div>
  </section>
</Base>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 56px;
    padding-block: clamp(56px, 8vw, 104px) 48px;
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .hero .lede {
    margin-top: 22px;
  }
  .hero__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tabs {
    overflow: hidden;
    background: var(--code-bg);
  }
  .tabs__bar {
    display: flex;
    gap: 4px;
    padding: 8px 10px 0;
    border-bottom: 1px solid #26262b;
  }
  .tabs__bar button {
    border: 0;
    background: transparent;
    color: var(--code-dim);
    padding: 8px 10px 10px;
    font-size: 13px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tabs__bar button:hover {
    color: var(--code-ink);
  }
  .tabs__bar button[aria-selected='true'] {
    color: #fafafa;
    border-bottom-color: var(--accent);
  }
  .tabs .code {
    border-radius: 0;
    min-height: 300px;
  }

  .upstreams {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-bottom: 72px;
    font-size: 15px;
    color: var(--body);
  }

  .status {
    font-family: var(--font);
  }
  .dot--idle {
    background: var(--muted);
  }
  .note {
    margin: 12px 0 0;
    font-size: 13px;
  }

  .list {
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--body);
    font-size: 15px;
  }
  .list li + li {
    margin-top: 6px;
  }

  .compare th[scope='row'] {
    font-weight: 400;
    color: var(--body);
    background: transparent;
    border-top: 1px solid var(--line);
    white-space: normal;
  }
  .compare td {
    white-space: normal;
  }
  .soon {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--accent-text);
    background: var(--accent-soft);
  }

  .quick {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 860px) {
    .quick {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .quick .copy {
    margin-top: 16px;
  }
  .small {
    font-size: 14px;
  }
</style>
