---
import Base from '../layouts/Base.astro';

const apps = [
  { name: 'Writing assistant', spent: 48.6, cap: 200, until: 'Feb 5' },
  { name: 'Code helper', spent: 471.2, cap: 500, until: 'Dec 31' },
  { name: 'Translate', spent: 6.15, cap: 50, until: 'May 1' },
];

const activity = [
  { app: 'Code helper', amount: '−12.40' },
  { app: 'Writing assistant', amount: '−3.20' },
  { app: 'Study notes', amount: 'Not charged', note: 'service didn’t respond' },
];

const charges = [
  { when: 'The AI service didn’t respond', result: 'Not charged' },
  { when: 'A backup model finished the job', result: 'Charged once' },
  { when: 'The request was retried after a dropped connection', result: 'Never charged twice' },
  { when: 'Usage couldn’t be confirmed', result: 'Held, then settled after review' },
  { when: 'The app reached the limit you set', result: 'It stops; nothing else is charged' },
];

const faqs = [
  { q: 'Which apps support it?', a: 'The first apps will be listed when SuperRouter Cloud opens.' },
  {
    q: 'Do credits expire?',
    a: 'That depends on the plan; terms are published before launch. Credits that expire soonest are spent first.',
  },
  { q: 'Can I get a refund?', a: 'The refund policy will be published before top-ups open.' },
  { q: 'What happens when I run out?', a: 'Requests pause until you top up or raise a limit. Nothing switches to another payer.' },
  { q: 'Are credits money?', a: 'No. Credits pay for AI usage on SuperRouter. They aren’t cash and can’t be transferred.' },
  { q: 'Can apps see my card?', a: 'No. Apps get the spending permission you approve, nothing more.' },
];

const fmt = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<Base
  title="SuperRouter Wallet — one balance for every AI app"
  description="Top up once and pay in any AI app that offers Sign in with SuperRouter. Set a limit for each app and turn access off anytime."
  section="wallet"
>
  <section class="hero wrap">
    <div>
      <h1 class="h1">One balance for every AI app.</h1>
      <p class="lede">
        Top up once, then pay in any app that offers Sign in with SuperRouter. You decide how much
        each app can spend, and you can turn it off at any time.
      </p>
      <form id="join" class="waitlist" data-waitlist="wallet" novalidate>
        <label class="visually-hidden" for="email">Email</label>
        <input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        <button class="btn btn--accent" type="submit">Join the waitlist</button>
        <p class="status muted" data-waitlist-status role="status" aria-live="polite">
          SuperRouter Cloud isn’t open for sign-ups yet.
        </p>
      </form>
    </div>

    <figure class="wallet panel" aria-label="Example wallet">
      <div class="wallet__balance">
        <span class="muted">Available</span>
        <strong class="num">1,280.00</strong>
        <span class="muted">credits</span>
      </div>
      <div class="wallet__group">
        <p class="wallet__label">Apps you’ve allowed</p>
        <ul>
          {
            apps.map((a) => {
              const pct = Math.round((a.spent / a.cap) * 100);
              const near = pct >= 90;
              return (
                <li class="app">
                  <div class="app__row">
                    <span>{a.name}</span>
                    <span class="num muted">
                      <span class={near ? 'accent-text' : 'ink'}>{fmt(a.spent)}</span> / {a.cap}
                    </span>
                  </div>
                  <div class="bar" aria-hidden="true">
                    <span class={near ? 'bar__fill bar__fill--near' : 'bar__fill'} style={`width:${pct}%`} />
                  </div>
                  <p class="app__meta muted">
                    Until {a.until}
                    {near && ' · close to its limit'}
                  </p>
                </li>
              );
            })
          }
        </ul>
      </div>
      <div class="wallet__group">
        <p class="wallet__label">Recent</p>
        <ul>
          {
            activity.map((r) => (
              <li class="act">
                <span>
                  {r.app}
                  {r.note && <span class="muted"> · {r.note}</span>}
                </span>
                <span class="num">{r.amount}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <figcaption class="muted">Example data</figcaption>
    </figure>
  </section>

  <section id="how" class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="h2">Sign in once. Approve what each app can spend.</h2>
        <p class="copy">
          The first time an app asks, you see exactly what it wants and set its monthly limit.
          Signing in and spending are asked separately.
        </p>
      </div>
      <div class="how">
        <div class="consent panel" aria-label="Example permission screen">
          <p class="consent__title">Writing assistant wants to use your SuperRouter credits</p>
          <p class="muted consent__sub">Text generation only</p>
          <fieldset class="seg">
            <legend class="muted">Monthly limit, in credits</legend>
            <div class="seg__opts">
              <label><input type="radio" name="cap" value="50" /><span>50</span></label>
              <label><input type="radio" name="cap" value="200" checked /><span>200</span></label>
              <label><input type="radio" name="cap" value="500" /><span>500</span></label>
            </div>
          </fieldset>
          <div class="consent__row">
            <span class="muted">Access lasts</span><span>90 days</span>
          </div>
          <div class="consent__actions">
            <button type="button" class="btn btn--ghost">Don’t allow</button>
            <button type="button" class="btn btn--accent">Allow</button>
          </div>
        </div>
        <div class="cells">
          <div>
            <h3 class="h3">A limit for every app</h3>
            <p>When an app reaches its limit it stops. It never falls back to charging somewhere else.</p>
          </div>
          <div>
            <h3 class="h3">Turn access off anytime</h3>
            <p>Once access is off, new requests from that app are declined.</p>
          </div>
          <div>
            <h3 class="h3">Your card stays with you</h3>
            <p>Apps receive a spending permission, never your payment details.</p>
          </div>
          <div>
            <h3 class="h3">Every charge is listed</h3>
            <p>See what each app spent, when, and anything that wasn’t charged.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="charges" class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="h2">You pay for results, not for failures.</h2>
        <p class="copy">
          Credits are held before each request and settled on what was actually used. Whatever is
          left goes back to your balance.
        </p>
      </div>
      <div class="table-box">
        <table class="table">
          <thead>
            <tr><th scope="col">When</th><th scope="col">What you pay</th></tr>
          </thead>
          <tbody>
            {
              charges.map((c) => (
                <tr>
                  <td>{c.when}</td>
                  <td>{c.result}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="wrap">
      <h2 class="h2">Questions</h2>
      <dl class="faq">
        {
          faqs.map((f) => (
            <div>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>

<script>
  import '../scripts/waitlist.ts';
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 56px;
    padding-block: clamp(56px, 8vw, 104px);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .hero .lede {
    margin-top: 22px;
  }
  .waitlist {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 480px;
  }
  .waitlist .input {
    flex: 1 1 240px;
    width: auto;
  }
  .status {
    flex-basis: 100%;
    margin: 0;
    font-size: 13px;
  }
  .status[data-tone='error'] {
    color: #dc2626;
  }
  .status[data-tone='ok'] {
    color: var(--ok);
  }

  .wallet {
    margin: 0;
    padding: 24px;
    font-size: 14px;
  }
  .wallet ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ink {
    color: var(--ink);
  }
  .wallet__balance {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .wallet__balance strong {
    font-size: 40px;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .wallet__group {
    padding-top: 18px;
  }
  .wallet__label {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }
  .app {
    padding: 10px 0;
  }
  .app + .app {
    border-top: 1px solid var(--line);
  }
  .app__row,
  .act {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .bar {
    margin-top: 8px;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .bar__fill {
    display: block;
    height: 100%;
    background: var(--ink);
  }
  .bar__fill--near {
    background: var(--accent);
  }
  .app__meta {
    margin: 6px 0 0;
    font-size: 12px;
  }
  .act {
    padding: 9px 0;
  }
  .act + .act {
    border-top: 1px solid var(--line);
  }
  .wallet figcaption {
    margin-top: 14px;
    font-size: 12px;
  }

  .how {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .how {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .consent {
    padding: 24px;
  }
  .consent__title {
    margin: 0;
    font-weight: 600;
  }
  .consent__sub {
    margin: 2px 0 0;
    font-size: 14px;
  }
  .seg {
    margin: 20px 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .seg legend {
    padding: 0;
    margin-bottom: 8px;
    font-size: 13px;
  }
  .seg__opts {
    display: flex;
    padding: 3px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .seg label {
    flex: 1;
    position: relative;
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .seg span {
    display: block;
    text-align: center;
    padding: 7px 0;
    border-radius: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .seg input:checked + span {
    background: var(--bg-subtle);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--accent);
  }
  .consent__row {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 14px;
  }
  .consent__actions {
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .faq {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0 48px;
  }
  .faq > div {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .faq dt {
    font-weight: 600;
  }
  .faq dd {
    margin: 6px 0 0;
    color: var(--body);
    font-size: 15px;
  }
</style>
