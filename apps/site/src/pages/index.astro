---
import Base from '../layouts/Base.astro';

const fonts =
  'https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,300..1000&display=swap';

const bubbles = [
  { label: 'Writing assistant', value: '−3.20', place: 'b1', tone: 'pink' },
  { label: 'Translate', value: '−0.85', place: 'b2', tone: 'mint' },
  { label: 'Code helper', value: '−12.40', place: 'b3', tone: 'peach' },
  { label: 'Study notes', value: 'Not charged', place: 'b4', tone: 'clear' },
];

const scallops = Array.from({ length: 12 }, (_, i) => {
  const angle = (i / 12) * Math.PI * 2;
  return { cx: 100 + Math.sin(angle) * 78, cy: 100 - Math.cos(angle) * 78 };
});

const charges = [
  { when: 'The AI service didn’t respond', result: 'Not charged' },
  { when: 'A backup model finished the job', result: 'Charged once' },
  { when: 'Your connection retried the request', result: 'Never charged twice' },
  { when: 'Usage couldn’t be confirmed', result: 'Settled after review', warn: true },
];

const faqs = [
  { q: 'Which apps support it?', a: 'We’ll publish the first apps when SuperRouter Cloud opens.' },
  {
    q: 'Do credits expire?',
    a: 'It depends on the plan, and the terms are published before launch. Credits that expire soonest are spent first.',
  },
  { q: 'Can I get a refund?', a: 'The refund policy will be published before top-ups open.' },
  {
    q: 'What happens when I run out?',
    a: 'Requests pause until you top up or raise a limit. Nothing switches to another payer.',
  },
];
---

<Base
  title="SuperRouter Wallet — one balance for every AI app"
  description="Top up once and pay in any AI app that offers Sign in with SuperRouter. Set a limit for each app and turn access off anytime."
  fonts={fonts}
  themeColor="#FDF8FF"
>
  <div class="page">
    <header class="top">
      <div class="top__bar glass">
        <a class="brand" href="/">
          <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
            <circle cx="14" cy="14" r="13" fill="#5B3FD9"></circle>
            <rect x="8" y="11" width="12" height="7" rx="3.5" fill="#FFD8E4"></rect>
          </svg>
          SuperRouter Wallet
        </a>
        <nav aria-label="Main">
          <a href="#control">Control</a>
          <a href="#charges">Charges</a>
          <a href="#faq">FAQ</a>
          <a href="/developers">Developers</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero wrap">
        <div class="hero__copy">
          <h1>One balance.<br /><span class="accent">Every AI app.</span></h1>
          <p class="lede">
            Top up once, then pay in any AI app that offers Sign in with SuperRouter. You decide how
            much each app can spend, and for how long.
          </p>
          <form class="waitlist" data-waitlist="wallet" novalidate>
            <div class="field">
              <label for="hero-email">Email</label>
              <input id="hero-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
            </div>
            <button type="submit" class="btn btn--primary">Notify me</button>
            <p class="waitlist__status" data-waitlist-status role="status" aria-live="polite">
              SuperRouter Cloud isn’t open for sign-ups yet.
            </p>
          </form>
        </div>

        <div class="hero__art" aria-label="Sample wallet: 1,280 credits available" role="img">
          <svg class="scallop" viewBox="0 0 200 200" aria-hidden="true">
            <g fill="#5B3FD9">
              <circle cx="100" cy="100" r="78"></circle>
              {scallops.map((s) => <circle cx={s.cx} cy={s.cy} r="22" />)}
            </g>
          </svg>
          <div class="balance" aria-hidden="true">
            <span class="balance__label">Available</span>
            <span class="balance__value">1,280</span>
            <span class="balance__label">credits · sample</span>
          </div>
          {
            bubbles.map((b) => (
              <div class={`bubble glass ${b.place} tone-${b.tone}`} aria-hidden="true">
                <span>{b.label}</span>
                <strong>{b.value}</strong>
              </div>
            ))
          }
        </div>
      </section>

      <section id="control" class="control wrap" aria-labelledby="control-title">
        <h2 id="control-title">Your wallet. <span class="accent">Your rules.</span></h2>
        <div class="bento">
          <article class="tile tile--consent">
            <h3>Tap once in the app.<br />Spend from your balance.</h3>
            <div class="sheet" aria-label="Preview of the permission screen">
              <div class="sheet__head">
                <svg width="48" height="48" viewBox="0 0 48 48" aria-hidden="true">
                  <path
                    d="M24 2c4 0 6 4 10 5s8-1 10 3-1 7 0 10 4 6 2 10-6 3-9 5-4 7-9 7-6-4-9-5-8 1-10-3 1-7 0-10-4-6-2-10 6-3 9-5 4-7 8-7z"
                    fill="#5B3FD9"></path>
                </svg>
                <div>
                  <p class="sheet__title">Writing assistant wants to use your credits</p>
                  <p class="sheet__sub">Text generation only</p>
                </div>
              </div>
              <fieldset class="segmented">
                <legend class="segmented__legend">Monthly limit, in credits</legend>
                <div class="segmented__options">
                  <label><input type="radio" name="cap" value="50" /><span>50</span></label>
                  <label><input type="radio" name="cap" value="200" checked /><span>200</span></label>
                  <label><input type="radio" name="cap" value="500" /><span>500</span></label>
                </div>
              </fieldset>
              <div class="sheet__actions">
                <button type="button" class="btn btn--text">Don’t allow</button>
                <button type="button" class="btn btn--primary">Allow</button>
              </div>
            </div>
            <p>Signing in and spending are asked separately. Apps never see your payment details.</p>
          </article>

          <article class="tile tile--limit">
            <h3>Every app has its own limit</h3>
            <div class="meter-row"><span>Code helper</span><span class="num">471 / 500</span></div>
            <div class="meter" role="meter" aria-valuemin="0" aria-valuemax="500" aria-valuenow="471" aria-label="Code helper: 471 of 500 credits used">
              <span class="meter__used"></span><span class="meter__stop"></span><span class="meter__left"></span>
            </div>
            <p>When an app hits its limit, it stops. Nothing gets charged anywhere else.</p>
          </article>

          <article class="tile tile--revoke">
            <div>
              <h3>Turn access off anytime</h3>
              <p>Once it’s off, new requests from that app are declined.</p>
            </div>
            <button type="button" class="switch" role="switch" aria-checked="true" aria-label="Writing assistant access" data-switch>
              <span class="switch__thumb"></span>
            </button>
          </article>
        </div>
      </section>

      <section id="charges" class="charges" aria-labelledby="charges-title">
        <div class="wrap charges__inner">
          <div>
            <h2 id="charges-title">No result.<br /><span class="accent">No charge.</span></h2>
            <p>
              Credits are held before each request and settled on what was actually used. Whatever
              is left goes back to your balance.
            </p>
          </div>
          <ul>
            {
              charges.map((c) => (
                <li>
                  <span>{c.when}</span>
                  <strong class={c.warn ? 'warn' : undefined}>{c.result}</strong>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="faq" class="faq-band" aria-labelledby="faq-title">
        <div class="wrap">
          <div class="faq">
            <h2 id="faq-title">Good to know</h2>
            <dl>
              {
                faqs.map((f) => (
                  <div>
                    <dt>{f.q}</dt>
                    <dd>{f.a}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <footer class="foot">
            <span>SuperRouter Wallet · Prices, expiry and refund terms will be published before launch.</span>
            <a href="/developers">For developers</a>
          </footer>
        </div>
      </section>
    </main>
  </div>
</Base>

<script>
  import '../scripts/waitlist.ts';

  for (const sw of document.querySelectorAll<HTMLButtonElement>('[data-switch]')) {
    sw.addEventListener('click', () => {
      sw.setAttribute('aria-checked', sw.getAttribute('aria-checked') === 'true' ? 'false' : 'true');
    });
  }
</script>

<style>
  :global(body) {
    background: #fdf8ff;
    color: #1c1b22;
    font-family: 'Roboto Flex', system-ui, -apple-system, sans-serif;
  }
  :global(::selection) {
    background: #e8deff;
    color: #1c1b22;
  }
  :global(:focus-visible) {
    outline: 3px solid #5b3fd9;
    outline-offset: 3px;
  }

  .page {
    --primary: #5b3fd9;
    --primary-hover: #4a2fc0;
    --primary-container: #e8deff;
    --on-variant: #4a4458;
    --muted: #6e6880;
    --outline: #7a7289;
    overflow-x: clip;
  }

  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 48px);
  }

  .accent {
    color: var(--primary);
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  /* Header */
  .top {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding-inline: clamp(12px, 3vw, 32px);
  }
  .top__bar {
    max-width: 1180px;
    margin: 12px auto 0;
    border-radius: 999px;
    padding: 8px 8px 8px 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 750;
    font-size: 18px;
    color: inherit;
    text-decoration: none;
  }
  .top nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .top nav a {
    color: #1c1b22;
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    padding: 10px 16px;
    border-radius: 999px;
    transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  .top nav a:hover {
    background: rgb(255 255 255 / 0.7);
  }

  /* Hero */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: 104px;
  }
  .hero__copy {
    flex: 1.15 1 520px;
    min-width: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(46px, 5.4vw, 80px);
    font-weight: 820;
    font-variation-settings: 'wdth' 112, 'opsz' 144;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .lede {
    margin: 24px 0 0;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.6;
    color: var(--on-variant);
    max-width: 30em;
  }

  .waitlist {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    max-width: 560px;
  }
  .field {
    flex: 1 1 280px;
    position: relative;
    background: #ece6f3;
    border-radius: 16px 16px 4px 4px;
    box-shadow: inset 0 -2px 0 var(--primary);
  }
  .field label {
    position: absolute;
    left: 18px;
    top: 9px;
    font-size: 12px;
    font-weight: 600;
    color: var(--primary);
  }
  .field input {
    width: 100%;
    height: 60px;
    border: 0;
    background: transparent;
    padding: 22px 18px 6px;
    font-size: 17px;
    outline: none;
    caret-color: var(--primary);
  }
  .field:focus-within {
    box-shadow: inset 0 -3px 0 var(--primary);
  }
  .waitlist__status {
    flex-basis: 100%;
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .waitlist__status[data-tone='error'] {
    color: #b3261e;
  }
  .waitlist__status[data-tone='ok'] {
    color: #1f6b43;
  }

  .btn {
    min-height: 48px;
    border: 0;
    border-radius: 999px;
    padding: 0 26px;
    font-weight: 650;
    font-size: 16px;
    cursor: pointer;
    transition:
      background-color 200ms cubic-bezier(0.2, 0, 0, 1),
      border-radius 300ms cubic-bezier(0.2, 0, 0, 1);
  }
  .btn--primary {
    background: var(--primary);
    color: #fff;
  }
  .waitlist .btn--primary {
    height: 60px;
  }
  .btn--primary:hover {
    background: var(--primary-hover);
  }
  .btn--primary:active {
    border-radius: 14px;
  }
  .btn--primary:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .btn--text {
    background: transparent;
    color: var(--primary);
  }
  .btn--text:hover {
    background: var(--primary-container);
  }

  /* Hero art: the scallop badge with glass bubbles floating over it */
  .hero__art {
    flex: 1 1 400px;
    position: relative;
    max-width: 540px;
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .scallop {
    position: absolute;
    inset: 7%;
    width: 86%;
    height: 86%;
    animation: spin 48s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .balance {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-align: center;
  }
  .balance__label {
    font-size: 16px;
    color: #e8deff;
  }
  .balance__value {
    font-size: clamp(64px, 8.4vw, 112px);
    font-weight: 800;
    font-variation-settings: 'wdth' 122, 'opsz' 144;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .bubble {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 20px;
    font-size: 14px;
    border-radius: 999px;
    animation: float 7s ease-in-out infinite;
  }
  .bubble strong {
    font-size: 18px;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .b1 {
    left: -4%;
    top: 9%;
  }
  .b2 {
    right: -6%;
    top: 30%;
    border-radius: 26px;
    animation-delay: -2s;
  }
  .b3 {
    left: 0;
    bottom: 13%;
    border-radius: 50% 50% 50% 14px;
    padding: 18px 24px;
    animation-delay: -4s;
  }
  .b4 {
    right: 2%;
    bottom: 3%;
    animation-delay: -5.5s;
  }
  .tone-pink {
    --glass-tint: rgb(255 216 228 / 0.55);
  }
  .tone-mint {
    --glass-tint: rgb(200 240 216 / 0.55);
  }
  .tone-peach {
    --glass-tint: rgb(255 220 194 / 0.55);
  }
  .tone-clear strong {
    color: var(--primary);
  }
  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  /* Control bento */
  .control {
    padding-bottom: 120px;
  }
  h2 {
    margin: 0;
    font-size: clamp(34px, 4.4vw, 58px);
    font-weight: 800;
    font-variation-settings: 'wdth' 108, 'opsz' 96;
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 16em;
    text-wrap: balance;
  }
  .bento {
    margin-top: 48px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 16px;
  }
  @media (max-width: 860px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .tile--consent {
      grid-row: auto;
    }
  }
  .tile {
    border-radius: 40px;
    padding: clamp(26px, 3vw, 36px);
  }
  .tile h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 780;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .tile p {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.65;
  }
  .tile--consent {
    grid-row: span 2;
    background: var(--primary-container);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .tile--consent > p {
    margin: 0;
    color: #3b2e6b;
  }
  .sheet {
    background: #fff;
    border-radius: 28px;
    padding: 24px;
  }
  .sheet__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sheet__title {
    margin: 0;
    font-weight: 700;
    font-size: 17px;
  }
  .sheet__sub {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .segmented {
    margin: 20px 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .segmented__legend {
    padding: 0;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .segmented__options {
    clear: both;
    width: 100%;
    display: flex;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--outline);
    overflow: hidden;
  }
  .segmented label {
    flex: 1;
    position: relative;
    cursor: pointer;
  }
  .segmented label + label {
    box-shadow: inset 1px 0 0 var(--outline);
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .segmented span {
    display: block;
    text-align: center;
    padding: 12px 6px;
    font-size: 15px;
    transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  .segmented input:checked + span {
    background: var(--primary-container);
    font-weight: 700;
  }
  .segmented input:focus-visible + span {
    outline: 3px solid var(--primary);
    outline-offset: -3px;
  }
  .sheet__actions {
    margin-top: 18px;
    display: flex;
    gap: 10px;
  }
  .sheet__actions .btn {
    flex: 1;
    padding: 0 14px;
    white-space: nowrap;
  }
  .sheet__actions .btn--primary {
    flex: 1.3;
  }

  .tile--limit {
    background: #c8f0d8;
    border-radius: 40px 40px 40px 120px;
    color: #0f3a24;
  }
  .meter-row {
    margin-top: 22px;
    display: flex;
    justify-content: space-between;
    font-size: 15px;
  }
  .meter {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .meter__used {
    flex: 94;
    height: 16px;
    border-radius: 999px;
    background: #1f6b43;
  }
  .meter__stop {
    width: 4px;
    height: 28px;
    border-radius: 2px;
    background: #1f6b43;
  }
  .meter__left {
    flex: 6;
    height: 16px;
    border-radius: 999px;
    background: #9ed9b5;
  }

  .tile--revoke {
    background: #ffd8e4;
    border-radius: 120px 40px 40px 40px;
    color: #3e0a1e;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .tile--revoke > div {
    flex: 1 1 200px;
  }
  .switch {
    flex: 0 0 auto;
    width: 72px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    padding: 0 6px;
    display: flex;
    align-items: center;
    cursor: pointer;
    background: #f2ecfa;
    box-shadow: inset 0 0 0 2px var(--outline);
    transition: background-color 250ms cubic-bezier(0.2, 0, 0, 1);
  }
  .switch__thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--outline);
    transition:
      transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1),
      width 250ms,
      height 250ms,
      background-color 250ms;
  }
  .switch[aria-checked='true'] {
    background: var(--primary);
    box-shadow: none;
  }
  .switch[aria-checked='true'] .switch__thumb {
    width: 30px;
    height: 30px;
    background: #fff;
    transform: translateX(28px);
  }

  /* Charges */
  .charges {
    background: #1c1b22;
    color: #fdf8ff;
    border-radius: 56px 56px 0 0;
    padding-block: clamp(80px, 10vw, 128px);
    position: relative;
    overflow: hidden;
  }
  .charges::before {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    right: -120px;
    top: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(91 63 217 / 0.55), transparent 65%);
    pointer-events: none;
  }
  .charges__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .charges__inner > div {
    flex: 1 1 340px;
  }
  .charges .accent {
    color: #cdbdff;
  }
  .charges p {
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 1.65;
    color: #cac4d0;
    max-width: 26em;
  }
  .charges ul {
    flex: 1.3 1 480px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .charges li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 20px 26px;
    border-radius: 999px;
    background: #2b2933;
    font-size: 17px;
  }
  .charges li strong {
    color: #cdbdff;
  }
  .charges li strong.warn {
    color: #ffb1c8;
  }

  /* FAQ */
  .faq-band {
    background: #1c1b22;
    padding-bottom: 56px;
  }
  .faq {
    background: #fdf8ff;
    color: #1c1b22;
    border-radius: 48px;
    padding: clamp(32px, 5vw, 64px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
  }
  .faq h2 {
    flex: 1 1 240px;
    font-size: clamp(30px, 3vw, 40px);
  }
  .faq dl {
    flex: 2 1 480px;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px 40px;
  }
  .faq dt {
